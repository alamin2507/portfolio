---
import '@fontsource-variable/sofia-sans-condensed/wght.css';
import '@fontsource-variable/sofia-sans/wght.css';
import '../styles/global.css';
import { site } from '../data/site';
// The two Latin font files, preloaded so text does not reflow when they arrive.
import displayFont from '@fontsource-variable/sofia-sans-condensed/files/sofia-sans-condensed-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/sofia-sans/files/sofia-sans-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  noindex?: boolean;
}

const { title = `${site.name} · ${site.role}`, noindex = false } = Astro.props;
// Absolute addresses, built from `site` in astro.config.mjs (the current
// address is the fallback, e.g. a dev server started before `site` was set).
const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base);
const shareImage = new URL('/og.png', base);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={site.description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <!-- Link previews (Facebook, LinkedIn, WhatsApp, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, ${site.role}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#f3f2ee" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <script is:inline src="/main.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
